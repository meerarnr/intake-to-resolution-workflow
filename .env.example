# Copy to .env. Never commit real keys.
LLM_PROVIDER=mock          # mock | anthropic | openai | ollama
LLM_MODEL=                 # required for non-mock providers; never hardcoded
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=sqlite:///./data/app.db
CHECKPOINT_PATH=./data/checkpoints.db
